# 与 /vendor/lib/modules/ 对齐的可加载模块
CONFIG_QCA_CLD_WLAN=m
CONFIG_EXFAT_FS=m
CONFIG_RMNET_PERF=m
CONFIG_RMNET_SHS=m
CONFIG_RDBG=m
CONFIG_LLCC_PERFMON=m
# 指纹
CONFIG_FINGERPRINT_FPC=m
CONFIG_FINGERPRINT_FPC_FOD=m
CONFIG_FINGERPRINT_GOODIX=m
CONFIG_FINGERPRINT_GOODIX_FOD=m
# gspca / dvb mpq
CONFIG_USB_GSPCA=m
CONFIG_DVB_MPQ=m
# 保持 Droidspaces 全功能 + 无 LTO
CONFIG_PID_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_USER_NS=y
CONFIG_DEVTMPFS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_LTO_NONE=y
# 指纹模块 Makefile 多对象平铺导致 modpost 失败，暂关（后续单独修）
# CONFIG_FINGERPRINT_FPC is not set
# CONFIG_FINGERPRINT_FPC_FOD is not set
# CONFIG_FINGERPRINT_GOODIX is not set
# CONFIG_FINGERPRINT_GOODIX_FOD is not set
